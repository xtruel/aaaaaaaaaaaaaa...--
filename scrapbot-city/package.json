{
  "name": "scrapbot-city",
  "private": true,
  "version": "0.6.1",
  "description": "Scrapbot City: a pixel-art city builder about junk, robots and big choices.",
  "author": "Qwerty3D Games",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win dir",
    "dist:linux": "vite build && electron-builder --linux dir",
    "dist:mac": "vite build && electron-builder --mac dir",
    "i18n:check": "esbuild scripts/i18n-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/i18n-check.mjs --log-level=warning && node node_modules/.cache/i18n-check.mjs",
    "test": "vitest run",
    "art": "esbuild scripts/art/build.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/art.mjs --log-level=warning && node node_modules/.cache/art.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.qwerty3d.scrapbotcity",
    "productName": "Scrapbot City",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir",
      "category": "Game"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.simulation-games"
    }
  }
}
