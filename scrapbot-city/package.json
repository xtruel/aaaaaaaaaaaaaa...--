{
  "name": "scrapbot-city",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
