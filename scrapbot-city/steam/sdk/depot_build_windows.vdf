// SteamPipe depot script: Windows 64-bit build of Scrapbot City ("Scrapbot City.exe").
// Content: steam/content/windows, written by "npm run dist:steam" (copy of release/win-unpacked).

"DepotBuild"
{
	// PLACEHOLDER: replace 0000001 with the Windows depot ID (same number as in app_build.vdf)
	"DepotID" "0000001"

	// Overrides the ContentRoot of app_build.vdf for this depot (relative to steam/sdk).
	"ContentRoot" "../content/windows/"

	// Everything in the folder, subfolders included, goes to the root of the install folder.
	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}

	// Never shipped: debug symbols, and the App ID file used only for local tests (npm run steam:appid).
	"FileExclusion" "*.pdb"
	"FileExclusion" "steam_appid.txt"
}
